{
  "name": "nekosearch-monorepo",
  "private": true,
  "workspaces": [
    "apps/nekosearch",
    "apps/docs-site",
    "packages/documentation-engine"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build:engine": "npm run build --workspace @nestjs-docs/documentation-engine",
    "build:cli": "npm run build --workspace nekosearch",
    "build": "npm run build:engine && npm run build:cli",
    "start:nekosearch": "node apps/nekosearch/dist/apps/nekosearch/cli.js",
    "docs:build": "npm run build && node apps/nekosearch/dist/apps/nekosearch/maintenance/package-documentation.js",
    "docs:ingest": "npm run build && node apps/nekosearch/dist/apps/nekosearch/maintenance/cli.js ingest",
    "docs:build:mcp": "npm run build && node scripts/release/build-mcp-protocol-snapshot.mjs",
    "search:index": "npm run build && node apps/nekosearch/dist/apps/nekosearch/maintenance/cli.js index",
    "docs:site:dev": "npm run dev --workspace @nestjs-docs/docs-site --",
    "docs:site:build": "npm run build --workspace @nestjs-docs/docs-site",
    "docs:site:preview": "npm run preview --workspace @nestjs-docs/docs-site --",
    "docs:site:check": "npm run check --workspace @nestjs-docs/docs-site",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @nestjs-docs/docs-site",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "validate:qwen3": "npm run build && node scripts/validation/validate-qwen3-embedding.mjs",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "search:evaluate": "npm run build && node scripts/evaluation/evaluate-search.mjs",
    "search:compare": "npm run build && node scripts/evaluation/compare-retrieval.mjs",
    "package:pack": "npm run build && node scripts/ci/verify-package.mjs && node scripts/ci/verify-packed-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
